# ===== أساسي =====
DATABASE_URL="postgresql://postgres@localhost:5432/loyalty"
APP_URL="http://localhost:3000"            # في Railway: https://<domain> بدون / في النهاية
BUSINESS_SLUG="shahi-qamra"
BUSINESS_NAME="شاهي قمرا"

# ===== أسرار (إلزامية في الإنتاج) — ولّدها بـ: openssl rand -base64 48 =====
QR_SIGNING_SECRET=""     # توقيع QR وروابط البطاقات (تغييره يبطل كل الروابط)
HASH_SALT=""             # ملح هاش أكواد الاستبدال وبصمات الأجهزة
CRON_SECRET=""           # لمسار /api/cron/run (اختياري إذا استخدمت خدمة cron)

# ===== اختياري =====
QR_PASS_TTL_HOURS=48         # عمر QR داخل بطاقة Wallet (يُجدد تلقائياً قبل انتهائه)
QR_LIVE_TTL_SECONDS=90       # عمر QR الحيّ في صفحة العميل
SESSION_HOURS=12
API_RATE_LIMIT_PER_MINUTE=240

# ===== Apple Wallet (بدونها يعمل وضع التطوير: معاينة pass.json بلا توقيع ولا push) =====
APPLE_PASS_TYPE_ID="pass.com.example.shahiqamra"
APPLE_TEAM_ID=""
APPLE_SIGNER_CERT_PEM=""      # PEM أو base64 لـ PEM
APPLE_SIGNER_KEY_PEM=""
APPLE_SIGNER_KEY_PASSPHRASE=""
APPLE_WWDR_PEM=""             # Apple WWDR G4
APPLE_APNS_HOST="api.push.apple.com"

# ===== Google Wallet (بدونها: معاينة كائن الولاء فقط) =====
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_CLASS_SUFFIX="shahi_qamra_loyalty"
GOOGLE_SA_EMAIL=""
GOOGLE_SA_PRIVATE_KEY=""      # PEM أو base64 لـ PEM

# ===== التهيئة الأولى (npm run db:seed) =====
ADMIN_USERNAME=""
ADMIN_PASSWORD=""             # 12 حرفاً على الأقل

# ===== الاختبارات =====
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/loyalty_test"
